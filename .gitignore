# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt

# Salesforce CLI auth and org state
.sfdx/
.sf/

# MCP / Claude config (can hold tokens or env values); the skill folder stays tracked
.mcp.json
claude_desktop_config.json
.claude/settings.local.json

# Logs
*.log

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Cached API responses (keep the folder, not the contents)
data/cache/*
!data/cache/.gitkeep

# Generated output
output/
*.pdf

# OS / editor
.DS_Store
.vscode/
.idea/
